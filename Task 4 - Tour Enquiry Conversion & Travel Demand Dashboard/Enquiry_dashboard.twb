      <aliases enabled='yes' />
      <column caption='Country' datatype='string' name='[Calculation_0261163859308544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [hotel_country]&#13;&#10;  WHEN 50 THEN &quot;United States&quot;&#13;&#10;  WHEN 198 THEN &quot;United Kingdom&quot;&#13;&#10;  WHEN 105 THEN &quot;Germany&quot;&#13;&#10;  WHEN 70 THEN &quot;France&quot;&#13;&#10;  WHEN 8 THEN &quot;Canada&quot;&#13;&#10;  WHEN 204 THEN &quot;Spain&quot;&#13;&#10;  WHEN 77 THEN &quot;Italy&quot;&#13;&#10;  WHEN 144 THEN &quot;Australia&quot;&#13;&#10;  WHEN 182 THEN &quot;Japan&quot;&#13;&#10;  WHEN 63 THEN &quot;India&quot;&#13;&#10;  ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Lead Time' datatype='integer' name='[Calculation_0261163877494786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[date_time],[srch_ci])' />
      </column>
      <column caption='Lead Time Group' datatype='string' name='[Calculation_0261163878215683]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0261163877494786] &lt; 0 THEN &quot;Invalid&quot;&#13;&#10;ELSEIF [Calculation_0261163877494786] &lt;= 7 THEN &quot;0-7 Days&quot;&#13;&#10;ELSEIF [Calculation_0261163877494786] &lt;= 14 THEN &quot;8-14 Days&quot;&#13;&#10;ELSEIF [Calculation_0261163877494786] &lt;= 30 THEN &quot;15-30 Days&quot;&#13;&#10;ELSE &quot;30+ Days&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Enquiries' datatype='integer' name='[Calculation_1248524662378496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[travel.csv_44CC5E31DF654CEBAFCB2C77436DD055])' />
      </column>
      <column caption='Confirmed Bookings' datatype='integer' name='[Calculation_1248524662734849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_booking])' />
      </column>
      <column caption='Conversion Rate (%)' datatype='real' name='[Calculation_1248524663119874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1248524662734849]/[Calculation_1248524662378496]' />
